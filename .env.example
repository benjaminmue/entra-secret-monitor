# .env fuer docker compose
# Mehrere Tenants: Keys in TENANTS auflisten, Werte je Key mit Praefix setzen.

TENANTS=contoso,fabrikam

# --- Tenant 1 -------------------------------------------------------------
CONTOSO_DISPLAY_NAME=Contoso AG
CONTOSO_TENANT_ID=00000000-0000-0000-0000-000000000000
CONTOSO_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Variante A: Zertifikat (empfohlen, laeuft nicht nach 24 Monaten ab)
CONTOSO_CERT_PATH=/config/contoso.crt
CONTOSO_KEY_PATH=/config/contoso.key
# Variante B: Client Secret
#CONTOSO_CLIENT_SECRET=
CONTOSO_WARN_DAYS=30
CONTOSO_ERROR_DAYS=14
CONTOSO_INCLUDE_SP=false
#CONTOSO_APP_FILTER=
#CONTOSO_PUSH_URL=https://prtg.example.com:5050/XXXXXXXX

# --- Tenant 2 -------------------------------------------------------------
FABRIKAM_DISPLAY_NAME=Fabrikam GmbH
FABRIKAM_TENANT_ID=
FABRIKAM_CLIENT_ID=
FABRIKAM_CLIENT_SECRET=
FABRIKAM_WARN_DAYS=30
FABRIKAM_ERROR_DAYS=14

# --- Dienst --------------------------------------------------------------
LISTEN_ADDR=0.0.0.0
LISTEN_PORT=8099
# Schuetzt GUI, /prtg und /json. Leer lassen nur in abgeschotteten Netzen.
API_TOKEN=
# Sekunden, die ein Scanergebnis wiederverwendet wird
CACHE_TTL=1800
# Sekunden zwischen Push-Laeufen, 0 = aus (nur fuer PUSH_URL-Betrieb)
PUSH_INTERVAL=0
# Optionale Konfigurationsdatei statt Umgebungsvariablen
TENANTS_FILE=/config/tenants.json
