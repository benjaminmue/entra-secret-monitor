FROM python:3.12-slim

LABEL org.opencontainers.image.title="Entra Credential Portal" \
      org.opencontainers.image.description="Multi tenant portal for Entra ID credential expiry: web GUI with 2FA, daily distributed scans and per customer PRTG endpoints" \
      org.opencontainers.image.licenses="MIT"

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/opt/portal \
    LISTEN_ADDR=0.0.0.0 \
    LISTEN_PORT=8099 \
    PORTAL_DATABASE_URL=sqlite:////data/portal.db

WORKDIR /opt/portal

COPY requirements-portal.txt /opt/portal/requirements-portal.txt
RUN pip install --no-cache-dir -r /opt/portal/requirements-portal.txt

COPY app/ /opt/portal/app/
COPY portal/ /opt/portal/portal/

RUN useradd --system --uid 10001 --no-create-home portal \
    && mkdir -p /data && chown 10001:10001 /data
USER 10001
VOLUME ["/data"]

EXPOSE 8099

HEALTHCHECK --interval=60s --timeout=5s --start-period=15s --retries=3 \
    CMD ["python3", "-c", "import urllib.request,os;urllib.request.urlopen('http://127.0.0.1:'+os.environ.get('LISTEN_PORT','8099')+'/healthz',timeout=4).read()"]

CMD ["python3", "-m", "portal.serve"]
