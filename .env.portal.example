# .env für das Portal (v2). Der klassische Dienst in app/ nutzt weiterhin .env.
#
# Die beiden Schlüssel unten sind nicht regenerierbar: ein neuer
# PORTAL_ENCRYPTION_KEY macht alle gespeicherten Kundenzugangsdaten unlesbar,
# ein neuer PORTAL_SECRET_KEY meldet alle Sitzungen ab. Beide gehören ins
# Passwortsafe-Backup, bevor der Container das erste Mal startet.
#
# Erzeugen:
#   python3 -c "import secrets,base64;print(secrets.token_urlsafe(64));print(base64.b64encode(secrets.token_bytes(32)).decode())"

PORTAL_SECRET_KEY=
PORTAL_ENCRYPTION_KEY=

# --- Erstkonto -----------------------------------------------------------
# Wird nur angelegt, solange die Benutzertabelle leer ist. Danach kann die
# Variable entfernt werden. Passwortwechsel und 2FA werden beim ersten Login
# erzwungen.
PORTAL_BOOTSTRAP_USER=admin
PORTAL_BOOTSTRAP_PASSWORD=

# --- Datenbank -----------------------------------------------------------
# SQLite-Datei im Volume /data. Für PostgreSQL:
#   postgresql+psycopg://user:pass@host/db  (psycopg zusätzlich installieren)
PORTAL_DATABASE_URL=sqlite:////data/portal.db

# --- Dienst --------------------------------------------------------------
LISTEN_ADDR=0.0.0.0
LISTEN_PORT=8099
# Öffentliche Basis-URL, erscheint in den angezeigten Sensor-URLs
PORTAL_BASE_URL=https://entra-monitor.example.com
PORTAL_INSTANCE_NAME=Entra Credential Monitor
# Auf 1 setzen, wenn ein Reverse Proxy X-Forwarded-For liefert
PORTAL_TRUST_PROXY=0
# Nur für lokale Tests ohne TLS auf 0 setzen
PORTAL_COOKIE_SECURE=1

# --- Anmeldung -----------------------------------------------------------
PORTAL_SESSION_MINUTES=60
PORTAL_LOGIN_MAX_ATTEMPTS=5
PORTAL_LOCKOUT_MINUTES=15
PORTAL_PASSWORD_MIN_LENGTH=12

# --- Zeitplan ------------------------------------------------------------
# Ein Lauf pro Kunde und Tag, verteilt über 24 Stunden.
PORTAL_SCHEDULER=1
# Sekunden zwischen zwei Durchgängen des Schedulers
PORTAL_TICK_SECONDS=60
# Sekunden Pause zwischen zwei Kunden im selben Durchgang
PORTAL_GAP_SECONDS=10
# Ab diesem Datenalter in Stunden schlägt der PRTG-Kanal Datenalter an
PORTAL_STALE_HOURS=30
# Aufbewahrte Läufe je Kunde
PORTAL_HISTORY_RUNS=30
# Vorgabewerte für neue Kunden
PORTAL_WARN_DAYS=30
PORTAL_ERROR_DAYS=14
